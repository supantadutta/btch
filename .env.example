# ── Core ────────────────────────────────────────────────────────────
VANTAGE_ENV=dev                        # dev | staging | prod
VANTAGE_MODE=paper                     # paper | exchange_demo   ('live' is not accepted in V1)
LOG_LEVEL=INFO

# ── Database / cache ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://vantage:vantage@localhost:5432/vantage
REDIS_URL=redis://localhost:6379/0

# ── Auth / crypto ───────────────────────────────────────────────────
JWT_SECRET=change-me-64-random-bytes
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14
SECRET_ENCRYPTION_KEY=                 # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Market data (public endpoints, no keys required) ────────────────
BYBIT_REST_URL=https://api.bybit.com
BYBIT_WS_PUBLIC_URL=wss://stream.bybit.com/v5/public/linear
SYMBOLS=BTCUSDT,ETHUSDT
BASE_TIMEFRAME=1m

# ── Data quality thresholds (seconds) ───────────────────────────────
STALENESS_WARN_S=5
STALENESS_BLOCK_S=15
STALENESS_KILL_S=60

# ── Paper engine defaults (overridable per-account in UI) ───────────
PAPER_STARTING_BALANCE=100000
PAPER_TAKER_FEE_BPS=5.5                # 0.055%
PAPER_MAKER_FEE_BPS=2.0                # 0.020%
PAPER_SLIPPAGE_MODEL=spread_plus_bps   # touch | spread_plus_bps | impact
PAPER_SLIPPAGE_BPS=1.0
PAPER_LATENCY_MS=80
PAPER_MAX_LEVERAGE=5

# ── Exchange demo (Phase 5; leave empty in paper mode) ──────────────
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# ── Frontend ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
